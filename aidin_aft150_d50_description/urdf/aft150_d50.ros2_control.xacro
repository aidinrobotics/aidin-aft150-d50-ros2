<?xml version="1.0"?>
<!-- ros2_control block for one AFT150-D50.

     The state interface names are fixed: force_torque_sensor_broadcaster builds them from the
     sensor name and refuses to configure if they differ.

     The ros2_control name becomes the node name the hardware component creates, which is what
     makes the services here answer to the same names as the standalone node. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="aft150_d50_ros2_control"
               params="name
                       can_interface
                       can_mode:=fd_brs
                       data_type:=float_combined
                       rate_hz:=1000
                       set_id_can20:=0x230
                       set_id_canfd:=0x330">

    <ros2_control name="${name}" type="sensor">
      <hardware>
        <plugin>aidin_aft150_d50_hardware/Aft150D50SensorInterface</plugin>
        <param name="can_interface">${can_interface}</param>
        <param name="can_mode">${can_mode}</param>
        <param name="data_type">${data_type}</param>
        <param name="rate_hz">${rate_hz}</param>
        <param name="set_id_can20">${set_id_can20}</param>
        <param name="set_id_canfd">${set_id_canfd}</param>
        <param name="frame_id">${name}_link</param>
      </hardware>

      <sensor name="${name}">
        <state_interface name="force.x"/>
        <state_interface name="force.y"/>
        <state_interface name="force.z"/>
        <state_interface name="torque.x"/>
        <state_interface name="torque.y"/>
        <state_interface name="torque.z"/>
      </sensor>
    </ros2_control>

  </xacro:macro>

  <xacro:macro name="aft150_d50_link" params="name parent:=''">
    <link name="${name}_link"/>
    <xacro:if value="${parent != ''}">
      <joint name="${name}_joint" type="fixed">
        <parent link="${parent}"/>
        <child link="${name}_link"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </joint>
    </xacro:if>
  </xacro:macro>

</robot>
