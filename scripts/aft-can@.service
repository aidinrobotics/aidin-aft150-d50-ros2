# CAN 인터페이스 자동 기동 (udev 가 장치별로 이 유닛을 띄운다)
#   예) can1 이 나타나면 systemd 가 aft-can@can1.service 를 실행
# udev 에서 직접 ip link 를 부르지 않고 systemd 에 맡기는 이유:
#   udev RUN 은 실행 환경이 제한적이고 시간 제한이 있어 부팅 시점에 따라 실패할 수 있다.
[Unit]
Description=Bring up CAN interface %i for the AFT150-D50 driver
BindsTo=sys-subsystem-net-devices-%i.device
After=sys-subsystem-net-devices-%i.device

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/aft-can-up %i
# 어댑터를 뽑으면 인터페이스도 함께 사라지므로 별도 정리는 필요 없다.
ExecStop=-/sbin/ip link set %i down

[Install]
WantedBy=multi-user.target
