# Attaches an slcan serial adapter as a CAN interface (udev starts one unit per tty).
#   e.g. /dev/ttyACM0 appears, systemd runs aft-slcan@ttyACM0.service, and slcan0 shows up
#
# udev does not call slcand directly: a udev RUN has a restricted environment and a time limit,
# and slcand has to stay running for the interface to exist.
[Unit]
Description=Attach slcan adapter %i as a CAN interface for the AFT150-D50 driver
BindsTo=dev-%i.device
After=dev-%i.device

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/aft-slcan-up %i
ExecStop=-/usr/local/bin/aft-slcan-up %i down

[Install]
WantedBy=multi-user.target
